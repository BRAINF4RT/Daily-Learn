{
  "manifest_version": 3,
  "name": "Daily Learn",
  "version": "1.0.0",
  "description": "Learn something new every day: cited briefings on any topic from free sources, written by OpenRouter, LM Studio or Ollama models.",
  "action": { "default_title": "Daily Learn", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
